name: Extract Hidden Payload

on:
  push:
    branches:
      - main
  workflow_dispatch: # Actions sekmesinden manuel tetikleme izni

permissions:
  contents: write # Depoya (repo) yazma/commit atma izni

jobs:
  extract-and-commit:
    runs-on: ubuntu-latest

    steps:
      - name: Depoyu Klonla
        uses: actions/checkout@v4

      - name: Python 3.13 Kurulumu
        uses: actions/setup-python@v5
        with:
          python-version: '3.13' # Asıl kod 3.13 dışında çalışmayı reddediyor

      - name: Kütüphaneleri Kur
        run: |
          python -m pip install --upgrade pip
          # Dumper betiği sadece dahili kütüphaneleri kullanır, ancak 
          # kazıma işlemi için sonradan eklenecek kütüphaneleri buraya yazabilirsiniz.
          # Örnek: pip install requests bs4

      - name: Dumper Betiğini Çalıştır
        run: |
          # Önceki adımda verdiğim kodun dumper.py olarak kaydedildiğini varsayıyoruz
          python dumper.py

      - name: Çıkan Dosyaları Depoya Kaydet (Push)
        run: |
          git config --local user.email "github-actions[bot]@users.noreply.github.com"
          git config --local user.name "github-actions[bot]"
          git add gizli_kod.marshal disassembly.txt
          
          # Eğer yeni bir dosya oluştuysa commit at ve depoya gönder
          git commit -m "Otomatik: Gizli bytecode ve disassembly dosyaları çıkartıldı" || echo "Değişiklik yok, commit atlanıyor."
          git push
